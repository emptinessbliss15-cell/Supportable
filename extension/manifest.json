{
  "manifest_version": 3,
  "name": "Supportable",
  "version": "0.3.0",
  "description": "Supportable side-panel application for the page you are viewing.",
  "action": { "default_title": "Open Supportable" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting", "storage", "tabCapture", "sidePanel"],
  "host_permissions": ["https://*.supabase.co/*", "https://supportable.emptinessbliss15.workers.dev/*"],
  "side_panel": { "default_path": "panel.html" },
  "options_page": "options.html"
}
